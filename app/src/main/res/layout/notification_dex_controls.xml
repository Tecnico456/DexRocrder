<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dex_notification"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingTop="4dp"
    android:paddingEnd="6dp"
    android:paddingBottom="4dp">

    <!-- Indicador de Status (Ponto Colorido) + Cronômetro em Tempo Real (00:00) -->
    <LinearLayout
        android:id="@+id/notif_status_container"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:background="@drawable/bg_dex_timer_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="7dp"
        android:paddingEnd="7dp">

        <ImageView
            android:id="@+id/notif_status_dot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:contentDescription="Status da Gravação"
            android:src="@drawable/dot_status_ready" />

        <TextView
            android:id="@+id/notif_timer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="00:00"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_status_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:singleLine="true"
            android:text="PRONTO"
            android:textColor="#FF00E676"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Espaçador elástico compatível com RemoteViews -->
    <TextView
        android:id="@+id/notif_spacer"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:text="" />

    <!-- Barra de Botões de Ação (Idêntica ao Balão Flutuante e sempre visível na gravação) -->
    <LinearLayout
        android:id="@+id/notif_actions_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 1. Botão Gravar (●): Visível quando !isRecording -->
        <ImageButton
            android:id="@+id/btn_notif_record"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_notif_btn_record"
            android:contentDescription="Iniciar Gravação"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_notif_record_dot"
            android:visibility="visible" />

        <!-- 2. Botão Dinâmico Pausar (||) ⇄ Continuar (▶): Visível quando isRecording == true -->
        <ImageButton
            android:id="@+id/btn_notif_pause_resume"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_notif_btn_circle"
            android:contentDescription="Pausar Gravação"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_notif_pause"
            android:visibility="gone" />

        <!-- 3. Botão Parar (■): Visível quando isRecording == true -->
        <ImageButton
            android:id="@+id/btn_notif_stop"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_notif_btn_stop"
            android:contentDescription="Parar Gravação"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_stop_square"
            android:visibility="gone" />

        <!-- 4. Botão Pincel / Desenho na tela -->
        <ImageButton
            android:id="@+id/btn_notif_brush"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_notif_btn_circle"
            android:contentDescription="Alternar Pincel"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_notif_brush"
            android:visibility="visible" />

        <!-- 5. Botão Câmera / Facecam -->
        <ImageButton
            android:id="@+id/btn_notif_facecam"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_notif_btn_circle"
            android:contentDescription="Alternar Facecam"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_notif_facecam"
            android:visibility="visible" />

        <!-- 6. Botão Fechar (X) -->
        <ImageButton
            android:id="@+id/btn_notif_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_notif_btn_close"
            android:contentDescription="Fechar Controles"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_notif_close"
            android:visibility="visible" />
    </LinearLayout>

</LinearLayout>
